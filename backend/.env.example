# Neon PostgreSQL connection string (Asyncpg driver)
# Format: postgresql+asyncpg://<user>:<password>@<ep-xyz>.region.aws.neon.tech/<dbname>?ssl=require
DATABASE_URL=postgresql+asyncpg://neondb_owner:YOUR_NEON_PASSWORD@ep-sweet-pond-123456.us-east-2.aws.neon.tech/neondb

# JWT Authentication
SECRET_KEY=cognify-ai-super-secret-production-key-2026-hackathon
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Grok API (xAI)
GROK_API_KEY=xai-your-grok-api-key-here

